# 開発用の設定の例。コピーして .env にすると、docker compose が自動で読む(.env は Git に入れない)。
# 値を変えたあとは、`task up:k8s`(または docker compose up -d)で反映する。

# --- k8s につなぐとき(docker-compose.kubernetes.yaml を重ねる。task up:k8s) ---
# kubeconfig のパス(省略すると ~/.kube/config)
#KUBECONFIG_HOST_PATH=/home/you/.kube/config

# deploy の Pod の RuntimeClass(例: gvisor)。空なら、クラスターの既定のランタイム
#RUNTIME_CLASS=

# クラスターのドメイン。service の DNS 名("<serviceId>.<projectId>.svc.<ドメイン>")の最後になる。
# クラスターごとに違う。CoreDNS の Corefile の `kubernetes <ドメイン> in-addr.arpa ...` の行で確かめる。
#CLUSTER_DOMAIN=cluster.local

# service として作る k8s の Service の種類(ClusterIP、NodePort、LoadBalancer)。
# LoadBalancer は、deploy ごとに外部 IP を使い、利用者のポート(UDP を含む)を LAN に公開する。
#SERVICE_TYPE=ClusterIP

# --- プロジェクトの namespace の隔離(dev-docs/network-isolation.md) ---
# 外からの通信を中継する namespace(Traefik など)。ここからの通信を許可する。空なら許可しない
#INGRESS_NAMESPACE=
# インターネットへの出口から除く、内部のネットワーク(CIDR のカンマ区切り。IPv4)。空なら既定(10/8、172.16/12、192.168/16、169.254/16、100.64/10)
#EGRESS_BLOCKED_NETWORKS=

# --- ingress(Traefik の IngressRoute。dev-docs/endpoints/ingresses.md) ---
# ingress に払い出すホスト名("単語-色-動物.<ベースドメイン>")の、ベースドメイン
#INGRESS_BASE_DOMAIN=shconn.org
# 払い出さないサブドメイン(カンマ区切り)。指定すると既定の一覧を置き換える。
# 名前そのもの、または、名前の3つの単語のどれかが、これに含まれると払い出されない。
#INGRESS_RESERVED_SUBDOMAINS=www,api,app,auth,admin,registry,logs,mail,static,docs,status,traefik,dashboard
# Traefik の IngressRoute の apiVersion(group/version)と、受け付ける entryPoint の名前(カンマ区切り)
#TRAEFIK_API_VERSION=traefik.io/v1alpha1
#TRAEFIK_ENTRY_POINTS=web
# アクセスの集計の Traefik プラグインの名前(空なら使わない。Traefik にプラグインを入れてから指定する。dev-docs/ingress-plugins.md)
#INGRESS_STATS_PLUGIN=launchs-stats
# accessstats(集計の保存)が読む、Traefik の Pod の namespace とラベル。false にすると、クライアントの IP を保存しない
#ACCESS_STATS_TRAEFIK_NAMESPACE=traefik
#ACCESS_STATS_TRAEFIK_SELECTOR=app.kubernetes.io/name=traefik
#ACCESS_STATS_KEEP_CLIENTS=true
# アクセスログ(1 リクエストごと)を残す期間と、ingress ごとの行数の上限
#ACCESS_LOG_RETENTION=24h
#ACCESS_LOG_MAX_ROWS=10000

# --- volume(PVC。dev-docs/volume.md) ---
# volume 1つの大きさの上限(MB)。アカウントごとの上限は、認証のコンテナを作るときに設ける
#VOLUME_MAX_SIZE_MB=5120
# PVC の StorageClass。空ならクラスターの既定。拡張(リサイズ)に対応したものが前提
#VOLUME_STORAGE_CLASS=
# PVC のアクセスモード(ReadWriteMany か ReadWriteOnce)。ReadWriteMany は、複数のノードの Pod から同時に使えるが、StorageClass が対応している必要がある
# (Longhorn は NFS で提供する。ノードに NFS クライアントが要る)。ReadWriteOnce の volume は、replicas を 2 以上にして別のノードに置くと、起動できない。
# 作成済みの PVC のアクセスモードは、変えられない
#VOLUME_ACCESS_MODE=ReadWriteMany

# deploy の Pod の requests を、limits(deploy の大きさ)の何 % にするか(1 から 100。既定 100=同じ)。
# 小さくすると、使っていない分を予約せず、同じノードにたくさん置ける(limits は変わらない)。メモリは、100 のままを勧める。
#CPU_REQUEST_PERCENT=100
#MEMORY_REQUEST_PERCENT=100

# --- 開発環境の公開 ---
# nginx(https://<アドレス>:<ポート>)を、公開するアドレスとポート。既定は、手元だけ(127.0.0.1)の 18443。
# 別のアドレス(ホストの IP)で公開するときは、書く。自己署名の証明書も、その IP で有効になる(証明書は、アドレスが変わると、作り直される)。
#HTTPS_BIND_ADDRESS=127.0.0.1
#HTTPS_HOST_PORT=18443

# --- API トークンと webhook(dev-docs/api-tokens.md) ---
# API トークン(機械向けの JWT)の署名の秘密(64 文字以上。生成: openssl rand -hex 64)。空なら、機能は無効(発行も、使用もできない)
#API_TOKEN_SECRET=

# --- 認証(auth コンテナ。dev-docs/auth.md) ---
# backend が access token を検証する公開鍵(auth の JWKS)の URL。AUTH_JWKS_URL か DEV_USER_ID の、どちらか一方が必須
#AUTH_JWKS_URL=http://auth:8080/auth/.well-known/jwks.json
# 開発用の仮の認証(全てのリクエストが、このユーザーになる)。auth を起動せずに backend だけを試すときだけ。AUTH_JWKS_URL とは同時に指定できない
#DEV_USER_ID=user-dev
# 本番では true にする(AUTH_JWKS_URL が必須になり、DEV_USER_ID は指定できなくなる)
#AUTH_REQUIRE_JWKS=false
# 人間であることの確認(Cloudflare Turnstile。https://dash.cloudflare.com/ の Turnstile で、ウィジェットを作る)。
# サイトキーとシークレットキーを、両方書くと、ログインとサインアップに、確認が必要になる(両方空なら、無効。片方だけだと、起動しない)。
# 動作確認には、Cloudflare のテスト用のキーが使える: サイトキー 1x00000000000000000000AA / シークレット 1x0000000000000000000000000000000AA(必ず通る)、
# 2x00000000000000000000AB / 2x0000000000000000000000000000000AA(必ず失敗)。
#TURNSTILE_SITE_KEY=
#TURNSTILE_SECRET_KEY=
# トークンを作ったページのホスト名として許すもの(カンマ区切り。空なら、確かめない。本番では、サイトのホスト名を書くのを勧める)
#TURNSTILE_HOSTNAMES=localhost
# サインアップの公開範囲(open か invite)。invite のときは、サインアップに招待コード(invitationCode)が要る
#AUTH_SIGNUP_MODE=open
# 最初の管理者を、auth の起動時に作る(管理者が1人もいないときだけ。何度起動しても安全)。Kubernetes では、コマンドを手で実行しにくいので、これを使う。
# 名前と、パスワード(どちらか一方: 環境変数、または、ファイル=Secret のマウント)を、セットで指定する。作った後は、Secret から外してよい。
#AUTH_BOOTSTRAP_ADMIN_NAME=root
#AUTH_BOOTSTRAP_ADMIN_PASSWORD=
#AUTH_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/admin-password
# 管理者のパスワード(task admin:create のとき。省略すると、標準入力から1行読む)。コマンドの引数には書かない(履歴に残るため)
#AUTH_ADMIN_PASSWORD=
# X-Forwarded-For を信頼するプロキシの CIDR(カンマ区切り)。ここから来たリクエストだけ、元のクライアントの IP を X-Forwarded-For から取る
#AUTH_TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# ロックとレート制限の値(仮。回数と時間)
#AUTH_LOGIN_MAX_FAILURES=5
#AUTH_LOGIN_LOCK_DURATION=15m
#AUTH_LOGIN_IP_LIMIT=20
#AUTH_LOGIN_IP_WINDOW=1m
#AUTH_SIGNUP_IP_LIMIT=10
#AUTH_SIGNUP_IP_WINDOW=1h
# パスワードのハッシュ(argon2id、1回で 64MiB)を、同時に計算できる数(メモリを守る上限)
#AUTH_HASH_MAX_CONCURRENCY=4

# --- logcollector(dev-docs/logs.md) ---
# ログを残す期間、Pod ごとの大きさの上限(バイト。目安)、1行の長さの上限(バイト。超えたら切り詰める)
#LOG_RETENTION=168h
#LOG_MAX_BYTES_PER_POD=52428800
#LOG_MAX_LINE_BYTES=16384
# Pod ごとの書き込みの速さの上限(バイト/秒。超えた分は捨てて、捨てた数を印の行で残す)。LOG_MAX_LINE_BYTES 以上にすること
#LOG_INGEST_BYTES_PER_SEC=1048576
# 同時に追う Pod の数の上限、追う Pod を決め直す間隔、まとめて書く間隔
#LOG_MAX_STREAMS=500
#LOG_RECONCILE_INTERVAL=2s
#LOG_FLUSH_INTERVAL=1s

# --- watcher(dev-docs/watcher.md) ---
# 安定して動いていない状態が、これだけ続いた deploy を止める(安定の判定の5分より長く)
#CRASH_LOOP_UNHEALTHY_FOR=10m

# --- その他 ---
#HTTPS_HOST_PORT=18443
