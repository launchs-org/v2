# 開発用の設定の例。コピーして .env にすると、docker compose が自動で読む(.env は Git に入れない)。
# 値を変えたあとは、`task up:k8s`(または docker compose up -d)で反映する。

# --- k8s につなぐとき(docker-compose.kubernetes.yaml を重ねる。task up:k8s) ---
# kubeconfig のパス(省略すると ~/.kube/config)
#KUBECONFIG_HOST_PATH=/home/you/.kube/config

# deploy の Pod の RuntimeClass(例: gvisor)。空なら、クラスターの既定のランタイム
#RUNTIME_CLASS=

# クラスターのドメイン。service の DNS 名("<serviceId>.<projectId>.svc.<ドメイン>")の最後になる。
# クラスターごとに違う。CoreDNS の Corefile の `kubernetes <ドメイン> in-addr.arpa ...` の行で確かめる。
#CLUSTER_DOMAIN=cluster.local

# service として作る k8s の Service の種類(ClusterIP、NodePort、LoadBalancer)。
# LoadBalancer は、deploy ごとに外部 IP を使い、利用者のポート(UDP を含む)を LAN に公開する。
#SERVICE_TYPE=ClusterIP

# --- プロジェクトの namespace の隔離(docs/network-isolation.md) ---
# 外からの通信を中継する namespace(Traefik など)。ここからの通信を許可する。空なら許可しない
#INGRESS_NAMESPACE=
# インターネットへの出口から除く、内部のネットワーク(CIDR のカンマ区切り。IPv4)。空なら既定(10/8、172.16/12、192.168/16、169.254/16、100.64/10)
#EGRESS_BLOCKED_NETWORKS=

# --- ingress(Traefik の IngressRoute。docs/endpoints/ingresses.md) ---
# ingress に払い出すホスト名("単語-色-動物.<ベースドメイン>")の、ベースドメイン
#INGRESS_BASE_DOMAIN=launchs.org
# 払い出さないサブドメイン(カンマ区切り)。指定すると既定の一覧を置き換える。
# 名前そのもの、または、名前の3つの単語のどれかが、これに含まれると払い出されない。
#INGRESS_RESERVED_SUBDOMAINS=www,api,app,auth,admin,registry,logs,mail,static,docs,status,traefik,dashboard
# Traefik の IngressRoute の apiVersion(group/version)と、受け付ける entryPoint の名前(カンマ区切り)
#TRAEFIK_API_VERSION=traefik.io/v1alpha1
#TRAEFIK_ENTRY_POINTS=web

# --- volume(PVC。docs/volume.md) ---
# volume 1つの大きさの上限(MB)。アカウントごとの上限は、認証のコンテナを作るときに設ける
#VOLUME_MAX_SIZE_MB=5120
# PVC の StorageClass。空ならクラスターの既定。拡張(リサイズ)に対応したものが前提
#VOLUME_STORAGE_CLASS=
# PVC のアクセスモード(ReadWriteOnce か ReadWriteMany)。ReadWriteOnce の volume は、replicas を 2 以上にして別のノードに置くと、起動できない
#VOLUME_ACCESS_MODE=ReadWriteOnce

# --- watcher(docs/watcher.md) ---
# 安定して動いていない状態が、これだけ続いた deploy を止める(安定の判定の5分より長く)
#CRASH_LOOP_UNHEALTHY_FOR=10m

# --- その他 ---
#HTTPS_HOST_PORT=18443
