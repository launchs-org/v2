# 開発用: Next.js の開発サーバー(HMR つき)。リポジトリルートをマウントして使う。
FROM node:24-slim AS Develop

WORKDIR /app/frontend

# 本物の API につなぐ(未指定だと、画面は、見せかけのデータ(mock)で動く)。
ENV NEXT_PUBLIC_LAUNCHS_API_MODE=live NEXT_TELEMETRY_DISABLED=1
# pnpm を使う(ロックファイルが pnpm-lock.yaml のため)。
RUN corepack enable

# 開発サーバーを動かす(nginx が、/ をここ(3000)へ、/api と /auth を backend と auth へ振り分ける)
CMD [ "sh", "-c", "pnpm install --no-frozen-lockfile && pnpm exec next dev --hostname 0.0.0.0 --port 3000" ]

# ビルド: Next.js を、単独で動かせる形(standalone)で、ビルドする。
FROM node:24-slim AS Build

WORKDIR /app

ENV NEXT_PUBLIC_LAUNCHS_API_MODE=live NEXT_TELEMETRY_DISABLED=1
RUN corepack enable

# 依存だけを先に入れる(ソースが変わっても、依存の層を使い回すため)
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

# ソースを入れて、ビルドする
COPY frontend/ ./
RUN pnpm run build

# 本番用: standalone の出力を、Node で動かす(/api と /auth は、Traefik が backend と auth へ振り分けるので、ここには来ない)。
FROM node:24-slim AS Production

WORKDIR /app

ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0

COPY --from=Build /app/.next/standalone ./
COPY --from=Build /app/.next/static ./.next/static
# 非 root で動かす(node イメージの node ユーザー)
USER node
EXPOSE 3000
CMD [ "node", "server.js" ]
