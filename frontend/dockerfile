# 開発用: Vite の開発サーバー(HMR つき)。リポジトリルートをマウントして使う。
FROM node:24-slim AS Develop

WORKDIR /app/frontend

# 開発サーバーを動かす(nginx が、/ をここへ、/api と /auth を backend と auth へ振り分ける)
CMD [ "sh", "-c", "npm install && npm run dev" ]

# ビルド: 静的ファイルを作る。
FROM node:24-slim AS Build

WORKDIR /app

# 依存だけを先に入れる(ソースが変わっても、依存の層を使い回すため)
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# ソースを入れて、ビルドする
COPY frontend/ ./
RUN npm run build

# 本番用: 静的ファイルを、nginx で配る(SPA なので、無いパスは index.html に戻す)。
FROM nginx:1.29-alpine AS Production

COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
# セキュリティのヘッダは、テンプレート(nginx のイメージが、起動時に、環境変数を差し込んで、conf.d/security-headers.inc に書き出す)。
# 差し込むのは、CSP_ で始まる環境変数だけ(NGINX_ENVSUBST_FILTER)。nginx 自身の $uri などを、壊さないため。
COPY frontend/security-headers.inc.template /etc/nginx/templates/security-headers.inc.template
# 人間であることの確認(Turnstile)を使うときだけ、実行時に、CSP_TURNSTILE=https://challenges.cloudflare.com を指定する。
ENV CSP_TURNSTILE="" NGINX_ENVSUBST_FILTER="^CSP_"
COPY --from=Build /app/dist /usr/share/nginx/html
