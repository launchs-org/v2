FROM golang:1.27 AS Develop

# 各種ツールをインストール
RUN apt update && apt install -y curl git wget

# curl でインストール
RUN curl -sSfL https://raw.githubusercontent.com/air-verse/air/master/install.sh | sh -s

# マウントしたリポジトリは所有者がコンテナと違い、git が拒否する(dubious ownership)。
# そのため go build が Git の情報を取れずに失敗するので、開発用では埋め込まない。
ENV GOFLAGS=-buildvcs=false

# ワーキングディレクトリ設定(リポジトリルートをマウントする場所)
WORKDIR /app

# air を実行する(shared/ の変更でもリビルドされるよう、リポジトリルートから実行する)
CMD [ "air","-c","worker/.air.toml" ]


# ビルド: 静的なバイナリを作る(リポジトリルートを、ビルドコンテキストにして使う)。
FROM golang:1.27 AS Build

WORKDIR /src

# 依存だけを先に取る(ソースが変わっても、依存の層を使い回すため)
COPY go.mod go.sum ./
RUN go mod download

# ソースを入れて、ビルドする(C のライブラリに依存しない、静的なバイナリ)
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/worker ./worker/src

# 本番用: バイナリだけを入れた、小さなイメージ(シェルなし、非 root)。
FROM gcr.io/distroless/static-debian12:nonroot AS Production

COPY --from=Build /out/worker /worker
USER nonroot:nonroot
ENTRYPOINT [ "/worker" ]
